#!/usr/bin/env bash

#MISE description="Loads all Vault secrets as shell exports via Teller (use with eval)."

# Usage: eval $(mise run vault:export)
# This exports all secrets from .teller.yml into the current shell session.
# Requires: VAULT_ROLE_ID, VAULT_SECRET_ID (from .creds.env.yaml)

set -e

VAULT_ADDR="${VAULT_ADDR:-https://vault.home.sflab.io:8200}"

if [[ -z "${VAULT_TOKEN:-}" ]]; then
  if [[ -z "${VAULT_ROLE_ID:-}" ]] || [[ -z "${VAULT_SECRET_ID:-}" ]]; then
    echo "Error: Either VAULT_TOKEN or (VAULT_ROLE_ID + VAULT_SECRET_ID) must be set." >&2
    exit 1
  fi

  RESPONSE=$(curl -sf \
    -X POST \
    -H "Content-Type: application/json" \
    -d "{\"role_id\":\"${VAULT_ROLE_ID}\",\"secret_id\":\"${VAULT_SECRET_ID}\"}" \
    "${VAULT_ADDR}/v1/auth/approle/login")

  VAULT_TOKEN=$(echo "$RESPONSE" | python3 -c "import sys, json; print(json.load(sys.stdin)['auth']['client_token'])")

  if [[ -z "$VAULT_TOKEN" ]]; then
    echo "Error: Failed to obtain Vault token." >&2
    exit 1
  fi
fi

echo "export VAULT_ADDR=${VAULT_ADDR}"
VAULT_TOKEN="$VAULT_TOKEN" VAULT_ADDR="$VAULT_ADDR" teller sh | grep "^export"
