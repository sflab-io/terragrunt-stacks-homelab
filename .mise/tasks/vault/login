#!/usr/bin/env bash

#MISE description="Authenticates with Vault via AppRole and prints VAULT_TOKEN for eval."

# Usage: eval $(mise run vault:login)
# Requires: VAULT_ROLE_ID, VAULT_SECRET_ID (from .creds.env.yaml)
# Optional: VAULT_ADDR (defaults to https://vault.home.sflab.io:8200)

set -e

VAULT_ADDR="${VAULT_ADDR:-https://vault.home.sflab.io:8200}"

if [[ -z "${VAULT_ROLE_ID:-}" ]] || [[ -z "${VAULT_SECRET_ID:-}" ]]; then
  echo "Error: VAULT_ROLE_ID and VAULT_SECRET_ID must be set." >&2
  echo "Add them to .creds.env.yaml and run: mise run secrets:edit .creds.env.yaml" >&2
  exit 1
fi

RESPONSE=$(curl -sf \
  -X POST \
  -H "Content-Type: application/json" \
  -d "{\"role_id\":\"${VAULT_ROLE_ID}\",\"secret_id\":\"${VAULT_SECRET_ID}\"}" \
  "${VAULT_ADDR}/v1/auth/approle/login")

TOKEN=$(echo "$RESPONSE" | python3 -c "import sys, json; print(json.load(sys.stdin)['auth']['client_token'])")

if [[ -z "$TOKEN" ]]; then
  echo "Error: Failed to obtain Vault token." >&2
  exit 1
fi

echo "export VAULT_TOKEN=${TOKEN}"
echo "export VAULT_ADDR=${VAULT_ADDR}" >&2
echo "Vault token obtained successfully (TTL: 32 days)." >&2
